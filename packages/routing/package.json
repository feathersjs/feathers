{
  "name": "@feathersjs/routing",
  "version": "6.0.0-pre.0",
  "description": "Express and Koa compatible routers for Feathers applications",
  "keywords": [
    "feathers",
    "routing",
    "express",
    "koa"
  ],
  "license": "MIT",
